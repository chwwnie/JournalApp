<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Add a New Entry</title>
</head>
<style>

    .navbar.bg-primary {
        background-color: #c995e9 !important;
    }

    .btn-primary {
        background-color: #c995e9 !important;
        border-color: #c995e9 !important;
    }

    textarea::placeholder,
    input::placeholder {
        font-style: italic;
        color: #6c757d;
        font-size: 15px;
    }

    .btn-primary:hover {
        background-color: #632da5 !important;
        border-color: #512685 !important;
        transition: background-color 0.1s ease;
    }

</style>

<body>
    <%- include('header') %>

        <div class="container mt-5" style="max-width: 700px;">
            <div class="card shadow-sm p-4">
                <h2 class="mb-4 text-center">New Journal Entry</h2>
                <form action="/entries" method="POST">
                    <div class="mb-3">
                        <label for="date" class="form-label">Date</label>
                        <input type="date" id="date" name="date" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mood</label>
                        <div class="form-text mb-2">Select all that apply</div>
                        <div class="row row-cols-2 gx-3">
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="mood" id="moodHappy" value="Happy" required>
                                    <label class="form-check-label" for="moodHappy">Happy</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="mood" id="moodExcited" value="Excited">
                                    <label class="form-check-label" for="moodExcited">Excited</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="mood" id="moodCalm" value="Calm">
                                    <label class="form-check-label" for="moodCalm">Calm</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="mood" id="moodAnxious" value="Anxious">
                                    <label class="form-check-label" for="moodAnxious">Anxious</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="mood" id="moodSad" value="Sad">
                                    <label class="form-check-label" for="moodSad">Sad</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="mood" id="moodReflective" value="Reflective">
                                    <label class="form-check-label" for="moodReflective">Reflective</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="mood" id="moodOther" value="Other">
                                    <label class="form-check-label" for="moodOther">Other</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3 d-none" id="customMoodWrapper">
                        <label for="customMood" class="form-label">Custom Mood</label>
                        <input type="text" id="customMood" name="customMood" class="form-control" placeholder="How are you feeling?" maxlength="50">
                    </div>
                    <div class="mb-3">
                        <label for="content" class="form-label">Journal Content</label>
                        <textarea id="content" name="content" class="form-control" rows="6"
                            placeholder="Write your thoughts here..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Save Entry</button>
                </form>
            </div>
        </div>

    <script>
        const moodCheckboxes = document.querySelectorAll('input[name="mood"]');
        const moodOtherCheckbox = document.getElementById('moodOther');
        const customMoodWrapper = document.getElementById('customMoodWrapper');
        const customMoodInput = document.getElementById('customMood');

        function updateMoodValidation() {
            const anyChecked = Array.from(moodCheckboxes).some(input => input.checked);
            moodCheckboxes[0].required = !anyChecked;
        }

        moodCheckboxes.forEach(input => {
            input.addEventListener('change', () => {
                if (moodOtherCheckbox.checked) {
                    customMoodWrapper.classList.remove('d-none');
                    customMoodInput.required = true;
                    customMoodInput.focus();
                } else {
                    customMoodWrapper.classList.add('d-none');
                    customMoodInput.required = false;
                    customMoodInput.value = '';
                }
                updateMoodValidation();
            });
        });

        updateMoodValidation();
    </script>
</body>

</html>
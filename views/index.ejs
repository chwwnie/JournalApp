<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Welcome to Daily Journal</title>
</head>

<style>
    div.card {
        max-width: 800px;
        margin-top: 145px;
    }

    /* Slide the homepage card upward when the page loads */
    .card-float {
        transform: translateY(40px);
        opacity: 0;
        animation: slide-up 0.8s ease-out forwards;
    }

    @keyframes slide-up {
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    a.btn-primary {
        background-color: #c995e9 !important;
        border-color: #c995e9 !important;
    }

    a.btn-primary:hover {
        background-color: #632da5 !important;
        border-color: #512685 !important;
        transition: background-color 0.1s ease;
    }
</style>

<body>
    <%- include('header')%>

        <div class="container mt-5" style="max-width: 800px;">
            <div class="card shadow p-4 max auto card-float">
                <h1 class="text-center">Welcome to Daily Journal</h1>
                <p class="text-center" style="font-size: 1.5rem;">📖</p>
                <p class="text-center" style="font-family: 'Garamond', serif;">A place to organize your thoughts, reflect on your day and track your personal growth. :)</p>
                <a href="/entries" class="btn btn-primary d-block mx-auto mt-4">Start Journaling</a>
            </div>

        </div>


</body>

</html>
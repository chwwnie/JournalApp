<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Journal Entries</title>
</head>
<style>
    .past-entry-note {
        margin-top: 145px;
    }

    .past-entry-header {
        background-color: #c9a1ee;
        color: #000;
    }

    .past-entry-header:not(.collapsed) {
        background-color: #b084e4;
    }

    .past-entry-header .badge {
        background-color: rgba(0, 0, 0, 0.15);
        color: #000;
    }

    .accordion-body {
        position: relative;
        padding-bottom: 50px;
    }

    .entry-actions-container {
        position: absolute;
        bottom: 15px;
        right: 20px;
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .action-btn {
        opacity: 0.8;
        transition: all 0.2s ease-in-out;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .action-btn:hover {
        opacity: 1;
        transform: scale(1.05);
        /* Subtle grow effect when hovered */
    }

    .floating-add-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        background-color: #b084e4;

        color: #ffffff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        z-index: 9999;

    }

    /* The '+' sign inside the button */
    .plus-icon {
        font-size: 32px;
        font-weight: bold;
        line-height: 1;
        margin-top: -5px;
        /* Minor optical alignment tweak */
    }

    /* Hover and click effects */
    .floating-add-btn:hover {
        background-color: #c9a1ee;
        /* Lightens up on hover [cite: 2] */
        color: #ffffff;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.4);
    }

    .floating-add-btn:active {
        transform: scale(0.95) translateY(0);
        /* Depresses slightly when clicked */
    }

</style>

<body>
    <%- include('header') %>

        <div class="container mt-5">
            <% if (journalEntries.length===0) { %>
                <p class="text-center past-entry-note" style="font-style: italic;">No journal entries found.<br>Start <a href="/entries">journaling</a> to see your entries
                    here!</p>
                <% } else { %>
                    <div class="d-flex justify-content-end mb-3">
                        <form method="get" action="/past-entries" class="d-flex align-items-center gap-2 mb-0">

                            <select id="sortSelect" name="sort" class="form-select form-select-sm"
                                onchange="this.form.submit()">
                                <option value="" <%=!sort ? 'selected' : '' %>>Newest</option>
                                <option value="oldest" <%=sort==='oldest' ? 'selected' : '' %>>Oldest</option>
                                <option value="month" <%=sort==='month' ? 'selected' : '' %>>Month</option>
                            </select>
                        </form>
                    </div>
                    <!-- // displays entries in collapsible format -->
                    <div class="accordion" id="entriesAccordion">
                        <% journalEntries.forEach(function(entry, index) { %> 
                            <!-- creates a collapsible card for each entry + its contents -->
                            <div class="accordion-item mb-3 shadow-sm">
                                <h2 class="accordion-header d-flex align-items-center" id="heading-<%= index %>">
                                    <button class="accordion-button collapsed past-entry-header flex-grow-1"
                                        type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= index %>"
                                        aria-expanded="false" aria-controls="collapse-<%= index %>">

                                        <div class="w-100 d-flex justify-content-between align-items-center"
                                            style="font-weight: bold;">
                                            <span>
                                                <%= new Date(entry.date).toLocaleDateString() %>
                                            </span>
                                        </div>
                                    </button>
                                </h2>
                                <div id="collapse-<%= index %>" class="accordion-collapse collapse"
                                    aria-labelledby="heading-<%= index %>" data-bs-parent="#entriesAccordion">
                                    <div class="accordion-body">
                                        <span>
                                            <% if (Array.isArray(entry.mood)) { %>
                                                <% entry.mood.forEach(function(m) { %>
                                                    <span class="badge me-1 <%= 
                                                        m === 'Happy' ? 'bg-warning text-dark' : 
                                                        m === 'Sad' ? 'bg-primary' : 
                                                        m === 'Anxious' ? 'bg-info text-dark' : 
                                                        m === 'Calm' ? 'bg-success' : 
                                                        m === 'Excited' ? 'bg-danger' : 
                                                        m === 'Reflective' ? 'bg-secondary' : 
                                                        'bg-dark text-white' %>">
                                                        <%= m %>
                                                    </span>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <span class="badge bg-secondary">
                                                                <%= entry.mood %>
                                                            </span>
                                                            <% } %>
                                        </span>
                                        <p class="mb-0" style="margin-top: 16px; font-family: Verdana, sans-serif; font-size:13px; white-space: pre-wrap;"><%= entry.content %></p>
                                        <div class="entry-actions-container">
                                            <a href="/past-entries/<%= entry.id %>/edit"
                                                class="btn btn-sm btn-light action-btn" title="Edit entry">✏️</a>
                                            <a href="/past-entries/<%= entry.id %>/delete"
                                                class="btn btn-sm btn-danger action-btn" title="Delete entry">🗑️</a>


                                        </div>

                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                    <% } %>
        </div>
        <a href="/entries" class="floating-add-btn" title="Add New Entry">
            <span class="plus-icon">+</span>
        </a>

        </div>
</body>

</html>
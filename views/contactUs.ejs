<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Contact Us</title>
</head>
<style>
    .btn-primary {
        background-color: #b084e4;
        border-color: #b084e4;
        transition: all 0.2s ease-in-out;
    }

    .btn-primary:hover {
        background-color: #a06cd9;
        border-color: #a06cd9;
        box-shadow: 0 4px 8px rgba(160, 108, 217, 0.3);
    }

</style>
<body>
    <!-- Activity 4: Insert code here to include the header (found in the partials folder) to your page -->
    <%- include('header') %>

    <div class="container mt-3">
        <h2 class="text-center">Contact Us</h2>
        <form action="/submit" method="POST">
            <div class="mb-3 mt-3">
                <label for="name">Name:</label>
                <input type="name" class="form-control" id="name" placeholder="Enter Name" name="name" required>
            </div>
            <div class="mb-3 mt-3">
                <label for="email">Email:</label>
                <input type="email" class="form-control" id="email" placeholder="Enter Email" name="email" required>
            </div>
            
            <!-- Activity 3: Edit contact.ejs to include more form fields – Contact No. and Comments: -->
            <div class="mb-3 mt-3">
                <label for="contact">Contact No.:</label>
                <input type="text" class="form-control" id="contact" placeholder="Enter Contact No." name="contact" required>
            </div>

            <div class="mb-3 mt-3">
                <label for="comments">Comments:</label>
                <textarea class="form-control" id="comments" placeholder="Enter Comments" name="comments" required></textarea>
            </div>
            
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</body>
</html>